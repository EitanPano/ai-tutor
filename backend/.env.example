# Copy to .env to override defaults. The app runs fine without a .env file in development.
# Production (NODE_ENV=production) requires DATABASE_URL, FRONTEND_URL and AI_PROVIDER=anthropic.

# development | test | production
NODE_ENV=development
# Interface the API binds to (default loopback). Containers set 0.0.0.0 and must keep the
# host port mapping on 127.0.0.1.
HOST=127.0.0.1
# Port the API listens on
PORT=4000
# Postgres connection string (dev default matches compose.yaml; required in production)
DATABASE_URL=postgres://ai_tutor:ai_tutor@localhost:5432/ai_tutor
# Exact frontend origin, used by CORS and CSRF checks (required in production)
FRONTEND_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# fake (deterministic, free; refused in production) | anthropic
AI_PROVIDER=fake
# Model used when AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Per-user daily token budget (positive integer)
AI_DAILY_TOKEN_BUDGET=50000
# Kill switch for AI features: true | false
AI_ENABLED=true
# Milliseconds the fake provider waits between streamed deltas (integer >= 0)
AI_FAKE_DELAY_MS=20
