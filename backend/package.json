{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "format": "prettier --write . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "test": "vitest run",
    "db:ensure": "tsx --env-file-if-exists=.env src/lib/db/cli.ts ensure-db",
    "db:migrate": "tsx --env-file-if-exists=.env src/lib/db/cli.ts migrate",
    "db:rollback": "tsx --env-file-if-exists=.env src/lib/db/cli.ts rollback",
    "db:reset": "tsx --env-file-if-exists=.env src/lib/db/cli.ts reset",
    "db:seed": "tsx --env-file-if-exists=.env src/lib/db/cli.ts seed",
    "user:reset-password": "tsx --env-file-if-exists=.env src/lib/db/cli.ts reset-password"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
