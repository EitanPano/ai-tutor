{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../.orchestrate/api-contract.yaml -o src/types/api.ts && prettier --write src/types/api.ts",
    "format": "prettier --write . --ignore-path ../.prettierignore --ignore-path .gitignore"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
